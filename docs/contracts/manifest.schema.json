{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "VecturAI Building Manifest",
    "description": "Top-level manifest describing a building package with version and file references.",
    "type": "object",
    "required": [
        "buildingId",
        "name",
        "version",
        "floor",
        "files"
    ],
    "properties": {
        "buildingId": {
            "type": "string",
            "description": "Unique building identifier"
        },
        "name": {
            "type": "string",
            "description": "Human-readable building name"
        },
        "address": {
            "type": "string",
            "description": "Physical address"
        },
        "version": {
            "type": "integer",
            "description": "Data version for cache invalidation (monotonically increasing)",
            "minimum": 1
        },
        "floor": {
            "type": "string",
            "description": "Floor identifier (e.g., 'ground')",
            "default": "ground"
        },
        "files": {
            "type": "object",
            "description": "Map of contract filenames to their checksums",
            "properties": {
                "nav_graph": {
                    "type": "string"
                },
                "rooms": {
                    "type": "string"
                },
                "entrance_markers": {
                    "type": "string"
                },
                "route_rendering": {
                    "type": "string"
                }
            },
            "required": [
                "nav_graph",
                "rooms",
                "entrance_markers"
            ]
        },
        "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when this manifest was generated"
        },
        "preprocessorVersion": {
            "type": "string",
            "description": "Version of the nav-preprocessor that generated this data"
        }
    }
}